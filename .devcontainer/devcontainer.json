{
  "name": "Mercado Aprende - Python",
  "image": "mcr.microsoft.com/devcontainers/python:1-3.12-bookworm",
  "forwardPorts": [5000],
  "portsAttributes": {
    "5000": {"label": "Mercado Aprende", "onAutoForward": "openBrowser", "protocol": "http"}
  },
  "postCreateCommand": "python -m pip install -r requirements.txt",
  "postAttachCommand": "bash .devcontainer/start.sh"
}
